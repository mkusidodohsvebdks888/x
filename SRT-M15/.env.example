# Copy locally to a secrets manager; never commit real values.
# The program reads process environment variables, not .env automatically.
SRT_API_KEY=replace-with-a-random-32-plus-character-secret
# SRT_MODEL_ROOT=/path/to/SRT-M15
# SRT_STAGED_CHECKPOINT=/path/to/trusted/latest.pt
# Staged model appears as model ID srt-m15-staged only when configured.
# SRT_API_ENABLE_DEEPSEEK_API=1
# SRT_API_ENABLE_DEEPSEEK_WEB=1
# DEEPSEEK_API_KEY=your-private-key
# SRT_API_CORS_ORIGINS=http://localhost:3000
